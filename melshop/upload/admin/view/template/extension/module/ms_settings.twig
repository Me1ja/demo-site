{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-ms" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    <div class="alert {{ theme_active ? 'alert-success' : 'alert-warning' }}"><i class="fa fa-paint-brush"></i> {{ theme_active ? text_theme_active : text_theme_inactive }}</div>
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-sliders"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-ms" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#ms-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#ms-design" data-toggle="tab">{{ tab_design }}</a></li>
            <li><a href="#ms-contacts" data-toggle="tab">{{ tab_contacts }}</a></li>
            <li><a href="#ms-social" data-toggle="tab">{{ tab_social }}</a></li>
            <li><a href="#ms-blocks" data-toggle="tab">{{ tab_blocks }}</a></li>
          </ul>
          <div class="tab-content">
            <div class="tab-pane active" id="ms-general">
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_status }}</label>
                <div class="col-sm-9"><select name="module_ms_settings_status" class="form-control">
                  <option value="1"{% if module_ms_settings_status %} selected{% endif %}>{{ text_enabled }}</option>
                  <option value="0"{% if not module_ms_settings_status %} selected{% endif %}>{{ text_disabled }}</option>
                </select></div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_activate }}</label>
                <div class="col-sm-9"><label class="checkbox-inline"><input type="checkbox" name="activate_theme" value="1"{% if not theme_active %} checked{% endif %}> {{ help_activate }}</label></div>
              </div>
              {% for f in ['mobile_bar','show_desc','show_credit'] %}
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ attribute(_context, 'entry_' ~ f) }}</label>
                <div class="col-sm-9"><label class="checkbox-inline"><input type="checkbox" name="ms[{{ f }}]" value="1"{% if ms[f] %} checked{% endif %}> {{ text_yes }}</label></div>
              </div>
              {% endfor %}
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_credit_href }}</label>
                <div class="col-sm-9"><input type="text" name="ms[credit_href]" value="{{ ms.credit_href }}" class="form-control" placeholder="https://"></div>
              </div>
            </div>
            <div class="tab-pane" id="ms-design">
              {% for f in ['color_primary','color_accent','color_text','color_bg'] %}
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ attribute(_context, 'entry_' ~ f) }}</label>
                <div class="col-sm-9"><div class="input-group"><input type="color" value="{{ ms[f] }}" class="form-control" style="width:70px;padding:2px" oninput="this.parentNode.querySelector('.ms-hex').value=this.value"><input type="text" name="ms[{{ f }}]" value="{{ ms[f] }}" class="form-control ms-hex" style="width:140px"></div></div>
              </div>
              {% endfor %}
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_radius }}</label>
                <div class="col-sm-9"><input type="number" min="0" max="30" name="ms[radius]" value="{{ ms.radius }}" class="form-control" style="width:140px"></div>
              </div>
              <div class="form-group">
                <label class="col-sm-3 control-label">{{ entry_font }}</label>
                <div class="col-sm-9"><select name="ms[font]" class="form-control" style="max-width:280px">{% for f in fonts %}<option{% if f == ms.font %} selected{% endif %}>{{ f }}</option>{% endfor %}</select></div>
              </div>
            </div>
            <div class="tab-pane" id="ms-contacts">
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_phones }}</label><div class="col-sm-9"><textarea name="ms[phones]" rows="3" class="form-control" placeholder="+38 (0XX) 000-00-00">{{ ms.phones }}</textarea><p class="help-block">{{ help_lines }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_phone_note }}</label><div class="col-sm-9"><input type="text" name="ms[phone_note]" value="{{ ms.phone_note }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_hours }}</label><div class="col-sm-9"><input type="text" name="ms[hours]" value="{{ ms.hours }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_email }}</label><div class="col-sm-9"><input type="text" name="ms[email]" value="{{ ms.email }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_address }}</label><div class="col-sm-9"><input type="text" name="ms[address]" value="{{ ms.address }}" class="form-control"></div></div>
            </div>
            <div class="tab-pane" id="ms-social">
              {% for f in ['telegram','viber','instagram','facebook','tiktok','youtube'] %}
              <div class="form-group"><label class="col-sm-3 control-label">{{ f|capitalize }}</label><div class="col-sm-9"><input type="text" name="ms[social_{{ f }}]" value="{{ attribute(ms, 'social_' ~ f) }}" class="form-control" placeholder="https://"></div></div>
              {% endfor %}
            </div>
            <div class="tab-pane" id="ms-blocks">
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_topbar_text }}</label><div class="col-sm-9"><input type="text" name="ms[topbar_text]" value="{{ ms.topbar_text }}" class="form-control"></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_top_links }}</label><div class="col-sm-9"><textarea name="ms[top_links]" rows="4" class="form-control" placeholder="Доставка і оплата|index.php?route=information/information&amp;information_id=6">{{ ms.top_links }}</textarea><p class="help-block">{{ help_top_links }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_advantages }}</label><div class="col-sm-9"><textarea name="ms[advantages]" rows="5" class="form-control" placeholder="truck|Доставка по Україні|Новою поштою 1–2 дні">{{ ms.advantages }}</textarea><p class="help-block">{{ help_advantages }}</p></div></div>
              <div class="form-group"><label class="col-sm-3 control-label">{{ entry_footer_about }}</label><div class="col-sm-9"><textarea name="ms[footer_about]" rows="3" class="form-control">{{ ms.footer_about }}</textarea></div></div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
