{% if ms.advantages %}
<section class="ms-adv">
  <div class="container ms-adv__in">
    {% for a in ms.advantages %}
    <div class="ms-adv__item"><i class="fa {{ a.icon }}"></i><div><b>{{ a.title }}</b>{% if a.text %}<span>{{ a.text }}</span>{% endif %}</div></div>
    {% endfor %}
  </div>
</section>
{% endif %}
<footer class="ms-footer">
  <div class="container">
    <div class="ms-footer__cols">
      <div class="ms-footer__col ms-footer__about">
        <div class="ms-footer__name">{{ ms.store_name }}</div>
        {% if ms.footer_about %}<p>{{ ms.footer_about }}</p>{% endif %}
        {% if ms.socials %}
        <div class="ms-socials">
          {% for s in ms.socials %}<a href="{{ s.href }}" target="_blank" rel="noopener" aria-label="{{ s.name }}"><i class="fa {{ s.icon }}"></i></a>{% endfor %}
        </div>
        {% endif %}
      </div>
      {% if informations %}
      <div class="ms-footer__col">
        <h5>{{ text_information }}</h5>
        <ul class="list-unstyled">
          {% for information in informations %}<li><a href="{{ information.href }}">{{ information.title }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endif %}
      <div class="ms-footer__col">
        <h5>{{ text_service }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
          <li><a href="{{ return }}">{{ text_return }}</a></li>
          <li><a href="{{ special }}">{{ text_special }}</a></li>
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
        </ul>
      </div>
      <div class="ms-footer__col ms-footer__contacts">
        <h5>{{ ms_text.text_contacts }}</h5>
        {% for p in ms.phones %}<a class="ms-footer__phone" href="tel:{{ p.tel }}">{{ p.text }}</a>{% endfor %}
        {% if ms.hours %}<p><i class="fa fa-clock-o"></i> {{ ms.hours }}</p>{% endif %}
        {% if ms.email %}<p><i class="fa fa-envelope-o"></i> <a href="mailto:{{ ms.email }}">{{ ms.email }}</a></p>{% endif %}
        {% if ms.address %}<p><i class="fa fa-map-marker"></i> {{ ms.address }}</p>{% endif %}
      </div>
    </div>
    <div class="ms-footer__bottom">
      <span>© {{ ms.year }} {{ ms.store_name }}</span>
      {% if ms.show_credit %}<span class="ms-credit">{{ ms_text.text_credit }} {% if ms.credit_href %}<a href="{{ ms.credit_href }}" target="_blank" rel="noopener">MelShop</a>{% else %}MelShop{% endif %}</span>{% endif %}
    </div>
  </div>
</footer>
{% if ms.mobile_bar %}
<nav class="ms-bar" aria-label="Mobile navigation">
  <a href="{{ ms.home_href }}" class="ms-bar__i{% if ms.is_home %} is-active{% endif %}"><i class="fa fa-home"></i><span>{{ ms_text.text_home }}</span></a>
  <button type="button" class="ms-bar__i" data-ms-open="ms-drawer"><i class="fa fa-th-large"></i><span>{{ ms_text.text_catalog }}</span></button>
  <button type="button" class="ms-bar__i" data-ms-toggle="ms-search-open"><i class="fa fa-search"></i><span>{{ ms_text.text_search }}</span></button>
  <a href="{{ wishlist }}" class="ms-bar__i"><i class="fa fa-heart-o"></i><b class="ms-count" data-ms-count="wishlist"></b><span>{{ ms_text.text_wishlist }}</span></a>
  <a href="{{ ms.cart_href }}" class="ms-bar__i"><i class="fa fa-shopping-cart"></i><b class="ms-count" data-ms-count="cart"></b><span>{{ ms_text.text_cart }}</span></a>
</nav>
{% endif %}
<div class="ms-toast" id="ms-toast" role="status" aria-live="polite"></div>
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
</body></html>
