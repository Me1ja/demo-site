<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ title }}</title>
{% if robots %}<meta name="robots" content="{{ robots }}" />{% endif %}
<base href="{{ base }}" />
{% if description %}<meta name="description" content="{{ description }}" />{% endif %}
{% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}
<meta property="og:title" content="{{ title }}" />
<meta property="og:type" content="website" />
<meta property="og:url" content="{{ og_url }}" />
<meta property="og:image" content="{{ og_image ? og_image : logo }}" />
<meta property="og:site_name" content="{{ name }}" />
<meta name="theme-color" content="{{ ms.color_primary }}" />
<script src="catalog/view/javascript/jquery/jquery-2.1.1.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/bootstrap/css/bootstrap.min.css" rel="stylesheet" media="screen" />
<script src="catalog/view/javascript/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
<link href="catalog/view/javascript/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family={{ ms.font_url }}:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="catalog/view/theme/default/stylesheet/stylesheet.css" rel="stylesheet">
<link href="catalog/view/theme/melshop/stylesheet/melshop.css?v={{ ms.version }}" rel="stylesheet">
<style>:root{--ms-primary:{{ ms.color_primary }};--ms-primary-d:{{ ms.color_primary_dark }};--ms-accent:{{ ms.color_accent }};--ms-text:{{ ms.color_text }};--ms-bg:{{ ms.color_bg }};--ms-radius:{{ ms.radius }};--ms-font:'{{ ms.font }}',system-ui,-apple-system,'Segoe UI',Arial,sans-serif}</style>
{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script src="catalog/view/javascript/common.js" type="text/javascript"></script>
<script src="catalog/view/theme/melshop/js/melshop.js?v={{ ms.version }}" type="text/javascript"></script>
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}
{% for analytic in analytics %}
{{ analytic }}
{% endfor %}
</head>
<body class="ms{% if ms.mobile_bar %} ms-has-bar{% endif %}">
{% if ms.topbar_text %}<div class="ms-promo">{{ ms.topbar_text }}</div>{% endif %}
<nav id="top" class="ms-top">
  <div class="container ms-top__in">
    <div class="ms-top__links">
      {% for info in ms.top_links %}<a href="{{ info.href }}">{{ info.title }}</a>{% endfor %}
      <a href="{{ contact }}">{{ ms_text.text_contacts }}</a>
    </div>
    <div class="ms-top__right">
      {% if ms.hours %}<span class="ms-top__hours"><i class="fa fa-clock-o"></i> {{ ms.hours }}</span>{% endif %}
      {{ currency }}
      {{ language }}
      <div id="top-links" class="nav">
        <ul class="list-inline">
          <li class="dropdown"><a href="{{ account }}" title="{{ text_account }}" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user-o"></i> <span>{{ text_account }}</span> <span class="caret"></span></a>
            <ul class="dropdown-menu dropdown-menu-right">
              {% if logged %}
              <li><a href="{{ account }}">{{ text_account }}</a></li>
              <li><a href="{{ order }}">{{ text_order }}</a></li>
              <li><a href="{{ logout }}">{{ text_logout }}</a></li>
              {% else %}
              <li><a href="{{ register }}">{{ text_register }}</a></li>
              <li><a href="{{ login }}">{{ text_login }}</a></li>
              {% endif %}
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
<header class="ms-header" id="ms-header">
  <div class="container ms-header__in">
    <button type="button" class="ms-burger" data-ms-open="ms-drawer" aria-label="{{ ms_text.text_catalog }}"><i class="fa fa-bars"></i></button>
    <div id="logo" class="ms-logo">
      {% if logo %}
        {% if home == og_url %}<img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" />{% else %}<a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" /></a>{% endif %}
      {% else %}
        <a href="{{ home }}" class="ms-logo__text">{{ name }}</a>
      {% endif %}
    </div>
    <button type="button" class="ms-catbtn" data-ms-toggle="ms-catalog"><i class="fa fa-th-large"></i><span>{{ ms_text.text_catalog }}</span></button>
    <div class="ms-search">{{ search }}</div>
    {% if ms.phones %}
    <div class="ms-phones">
      <a href="tel:{{ ms.phones[0].tel }}" class="ms-phones__main">{{ ms.phones[0].text }}</a>
      <span class="ms-phones__note">{{ ms.phone_note }}</span>
      {% if ms.phones|length > 1 %}
      <div class="ms-phones__more">{% for p in ms.phones %}<a href="tel:{{ p.tel }}">{{ p.text }}</a>{% endfor %}</div>
      {% endif %}
    </div>
    {% endif %}
    <div class="ms-icons">
      <button type="button" class="ms-icon ms-icon--search" data-ms-toggle="ms-search-open" aria-label="Search"><i class="fa fa-search"></i></button>
      <a href="{{ ms.compare_href }}" class="ms-icon ms-icon--compare" title="{{ ms_text.text_compare }}"><i class="fa fa-balance-scale"></i><b class="ms-count" data-ms-count="compare"></b></a>
      <a href="{{ wishlist }}" id="wishlist-total" class="ms-icon ms-icon--wish" title="{{ text_wishlist }}"><i class="fa fa-heart-o"></i><b class="ms-count" data-ms-count="wishlist"></b><span class="sr-only">{{ text_wishlist }}</span></a>
      <div class="ms-cart">{{ cart }}</div>
    </div>
  </div>
  <div class="ms-catalog" id="ms-catalog">{{ menu }}</div>
</header>
<div class="ms-drawer" id="ms-drawer" aria-hidden="true">
  <div class="ms-drawer__panel">
    <div class="ms-drawer__head"><b>{{ ms_text.text_catalog }}</b><button type="button" data-ms-close aria-label="Close">&times;</button></div>
    <div class="ms-drawer__body" data-ms-drawer-menu></div>
    <div class="ms-drawer__extra">
      <a href="{{ account }}"><i class="fa fa-user-o"></i> {{ text_account }}</a>
      <a href="{{ wishlist }}"><i class="fa fa-heart-o"></i> {{ ms_text.text_wishlist }}</a>
      <a href="{{ ms.compare_href }}"><i class="fa fa-balance-scale"></i> {{ ms_text.text_compare }}</a>
      <a href="{{ contact }}"><i class="fa fa-envelope-o"></i> {{ ms_text.text_contacts }}</a>
      {% for p in ms.phones %}<a href="tel:{{ p.tel }}"><i class="fa fa-phone"></i> {{ p.text }}</a>{% endfor %}
    </div>
  </div>
</div>
